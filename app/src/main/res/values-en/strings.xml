    <string name="about_title">About ShizuLog</string>
    <string name="about_intro_title">About the App</string>
    <string name="about_intro">ShizuLog uses the Shell / Root privileges provided by Shizuku to read Logcat logs for apps you explicitly select. It is intended for crash analysis, troubleshooting, and app debugging. Logs are continuously written to files, and the current target and recent logs can be restored after the UI is recreated.</string>
    <string name="about_features_title">Key Features</string>
    <string name="about_features">✓ Choose a target app\n✓ Record main / system / crash logs in real time\n✓ Shizuku authorization\n✓ Crash snapshot capture\n✓ Session state recovery\n✓ Export log files</string>
    <string name="about_info_title">App Information</string>
    <string name="about_contributor">Contributor: ChatGPT</string>
    <string name="about_license">License: MIT</string>
    <string name="about_repo">Open-source GitHub repository</string>
    <string name="about_icon_desc">ShizuLog app icon</string>
    <string name="tip_home">Authorize Shizuku first, then choose a target app and start recording. After the target app crashes, return to ShizuLog and it will automatically try to capture a crash snapshot.</string>

